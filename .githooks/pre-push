#!/usr/bin/env bash
#
# Local gate before anything leaves this machine.
#
# .github/workflows/gates.yml calls the same checks in CI; this hook is the
# local half, and `core.hooksPath` is not committed, so it enforces nothing
# for anybody who has not run the one-time `git config` below.
#
# Install (once):  git config core.hooksPath .githooks
# Skip (rarely):   git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

pass=0
fail=0

step() {
  local name="$1"
  shift
  printf '  %-44s' "$name"
  if out=$(eval "$@" 2>&1); then
    printf 'ok\n'
    pass=$((pass + 1))
  else
    printf 'FAIL\n'
    printf '%s\n' "$out" | sed 's/^/      /'
    fail=$((fail + 1))
  fi
}

echo "pre-push gate"
step "shellcheck" "shellcheck up.sh down.sh routines.sh"
step "shell syntax" "bash -n up.sh && bash -n down.sh && bash -n routines.sh"
step "loopback only" "./scripts/loopback-only.sh"
step "one trust domain" "./scripts/one-trust-domain.sh"
step "gateway decides its upstream" "./scripts/gateway-decides-its-upstream.sh"
step "gateway semantic cache off" "./scripts/gateway-cache-is-off.sh"
step "gateway declassify key per run" "./scripts/declassify-is-keyed.sh"
step "cloud key per run" "./scripts/cloud-key-is-per-run.sh"
step "cloud key is not printed" "./scripts/cloud-key-is-not-printed.sh"
step "gateway admin key per run" "./scripts/admin-keys-are-per-run.sh"
step "gateway and broker postures held" "./scripts/postures-are-held.sh"
step "keyryx per run, wardryx signs through custody" "./scripts/keyryx-is-per-run.sh"
step "record signed through keyryx by default" "./scripts/record-is-signed-by-default.sh"
step "record seal pinned to custody's active key" "./scripts/record-key-is-pinned.sh"
step "policy plane fails closed" "./scripts/wardryx-fails-closed.sh"
step "gateway agent firewall from the switch" "./scripts/firewall-is-enforce.sh"
step "gateway PII masks from the switch" "./scripts/pii-is-shadow.sh"
step "revocation key not logged" "./scripts/revoke-key-not-printed.sh"
step "typed-answers data mode" "./scripts/typed-mode.sh"
step "gateway run-budget ceiling" "./scripts/run-budget-ceiling-is-set.sh"
step "bus file names match sources" "./scripts/bus-files-match-sources.sh"
step "chain-verify routine" "./scripts/chain-verify-routine.sh"
step "components.json is true" "./scripts/manifest-is-true.sh"
step "features are bound" "./scripts/features-are-bound.sh"
step "refusals keep their exit status" "./scripts/die-keeps-its-exit-status.sh"
step "demo issuer's trusted line is unbound" "./scripts/demo-issuer-is-unbound.sh"
step "bus directory stays this user's" "./scripts/bus-is-operator-owned.sh"
step "demo runs after the planes that answer it" "./scripts/demo-runs-after-its-planes.sh"
step "every component built from a release tag" "./scripts/pins-are-release-tags.sh"
step "typed risk signal holds what it never reaches" "./scripts/risk-hold-is-seeded.sh"

echo
if [ "$fail" -ne 0 ]; then
  echo "pre-push: $fail of $((pass + fail)) checks failed. Nothing pushed."
  exit 1
fi
echo "pre-push: all $pass checks passed."
