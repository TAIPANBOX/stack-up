#!/usr/bin/env bash
#
# Local gate before anything leaves this machine.
#
# .github/workflows/gates.yml calls the same checks in CI; this hook is the
# local half, and `core.hooksPath` is not committed, so it enforces nothing
# for anybody who has not run the one-time `git config` below.
#
# Install (once):  git config core.hooksPath .githooks
# Skip (rarely):   git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

pass=0
fail=0

step() {
  local name="$1"
  shift
  printf '  %-44s' "$name"
  if out=$(eval "$@" 2>&1); then
    printf 'ok\n'
    pass=$((pass + 1))
  else
    printf 'FAIL\n'
    printf '%s\n' "$out" | sed 's/^/      /'
    fail=$((fail + 1))
  fi
}

echo "pre-push gate"
step "shellcheck" "shellcheck up.sh down.sh routines.sh"
step "shell syntax" "bash -n up.sh && bash -n down.sh && bash -n routines.sh"
step "loopback only" "./scripts/loopback-only.sh"
step "one trust domain" "./scripts/one-trust-domain.sh"
step "gateway decides its upstream" "./scripts/gateway-decides-its-upstream.sh"

echo
if [ "$fail" -ne 0 ]; then
  echo "pre-push: $fail of $((pass + fail)) checks failed. Nothing pushed."
  exit 1
fi
echo "pre-push: all $pass checks passed."
